# =============================================================================
# TAILSCALE RENDER EXIT NODE - SECRET CONFIGURATION
# =============================================================================
# WARNING: This file contains placeholders ONLY.
# NEVER commit real secrets to version control.
# Copy this file to .env and fill in your actual values.
# =============================================================================

# Tailscale Authentication Key
# Get this from: https://login.tailscale.com/admin/settings/authkeys
# Generate a reusable, ephemeral key tagged for this service.
TAILSCALE_AUTHKEY=replace_with_real_key

# Hostname for this node in your Tailscale network
HOSTNAME=render-exit-node

# Optional extra flags for tailscale up
# TAILSCALE_EXTRA_ARGS=

# =============================================================================
# RENDER DEPLOYMENT
# =============================================================================
# These are only needed if deploying via Render API (not dashboard)
RENDER_API_KEY=replace_with_real_key_if_needed